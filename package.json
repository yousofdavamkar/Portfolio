{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run lint && bun run check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json && bun run check:backend",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"check:backend": "bun run tsc --project convex/tsconfig.json --noEmit",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"setup:dev": "bun scripts/provision-dev.ts",
		"tsc": "bun node_modules/@typescript/native/bin/tsc",
		"test:e2e": "playwright test",
		"start": "bun build/index.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "4.7.7",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@auth/core": "^0.41.3",
		"@convex-dev/auth": "^0.0.96",
		"@convex-dev/rate-limiter": "^0.4.2",
		"@fontsource/poppins": "^5.3.0",
		"@lucide/svelte": "^1.63.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"convex": "^1.48.0",
		"motion": "^14.7.1",
		"swr-store": "^1.0.0",
		"zustand": "^5.0.16"
	},
	"engines": {
		"node": ">=22.18.0",
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4"
}
