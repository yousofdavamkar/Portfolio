{
	"extends": "../tsconfig.strict.json",
	"compilerOptions": {
		"types": ["node"],
		"moduleResolution": "Bundler",
		"target": "ESNext",
		"lib": ["ES2023", "DOM"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"noEmit": true
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
